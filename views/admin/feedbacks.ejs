<%- include('../layouts/header') %>
<%- include('../layouts/navbar') %>

<div class="container">
  <div class="page-header">
    <div>
      <h1 class="page-title">💬 Quản Lý Ý Kiến & Phản Ánh Cư Dân</h1>
      <p class="page-subtitle">Theo dõi, điều phối xử lý và phản hồi khiếu nại của cư dân</p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <a href="/ai/tools" class="btn btn-accent">✨ Báo cáo Tuần bằng AI</a>
    </div>
  </div>

  <% if (success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <!-- STATS -->
  <div class="grid-4">
    <div class="card stat-card">
      <div class="stat-icon blue">📋</div>
      <div class="stat-info">
        <h3><%= stats.totalCount %></h3>
        <p>Tổng số phản ánh</p>
      </div>
    </div>
    <div class="card stat-card">
      <div class="stat-icon red">⏳</div>
      <div class="stat-info">
        <h3><%= stats.pendingCount %></h3>
        <p>Chờ tiếp nhận xử lý</p>
      </div>
    </div>
    <div class="card stat-card">
      <div class="stat-icon yellow">⚙️</div>
      <div class="stat-info">
        <h3><%= stats.inProgressCount %></h3>
        <p>Đang trong quá trình xử lý</p>
      </div>
    </div>
    <div class="card stat-card">
      <div class="stat-icon green">✅</div>
      <div class="stat-info">
        <h3><%= stats.resolvedCount %></h3>
        <p>Đã hoàn tất giải quyết</p>
      </div>
    </div>
  </div>

  <!-- FILTERS -->
  <div class="card" style="margin-bottom: 1.5rem;">
    <form action="/feedbacks" method="GET" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
      <div style="width: 200px;">
        <label>Trạng thái</label>
        <select name="status">
          <option value="">-- Tất cả trạng thái --</option>
          <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Chờ tiếp nhận</option>
          <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>Đang xử lý</option>
          <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>>Đã hoàn tất</option>
        </select>
      </div>

      <div style="width: 200px;">
        <label>Danh mục</label>
        <select name="category">
          <option value="">-- Tất cả danh mục --</option>
          <option value="Tiếng ồn" <%= filters.category === 'Tiếng ồn' ? 'selected' : '' %>>Tiếng ồn</option>
          <option value="Vệ sinh" <%= filters.category === 'Vệ sinh' ? 'selected' : '' %>>Vệ sinh</option>
          <option value="Kỹ thuật" <%= filters.category === 'Kỹ thuật' ? 'selected' : '' %>>Kỹ thuật / Cơ sở vật chất</option>
          <option value="An ninh" <%= filters.category === 'An ninh' ? 'selected' : '' %>>An ninh</option>
          <option value="Dịch vụ" <%= filters.category === 'Dịch vụ' ? 'selected' : '' %>>Dịch vụ</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary">Lọc Danh Sách</button>
      <a href="/feedbacks" class="btn btn-outline">Bỏ Lọc</a>
    </form>
  </div>

  <!-- LIST OF FEEDBACKS -->
  <div style="display: flex; flex-direction: column; gap: 1rem;">
    <% if (feedbacks.length === 0) { %>
      <div class="card" style="text-align: center; padding: 3rem; color: var(--text-muted);">
        Không có phản ánh nào phù hợp.
      </div>
    <% } else { %>
      <% feedbacks.forEach(f => { %>
        <div class="card" style="border-left: 5px solid <%= f.status === 'resolved' ? 'var(--success)' : (f.status === 'in_progress' ? 'var(--info)' : 'var(--danger)') %>;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem;">
            <div>
              <span class="badge badge-primary"><%= f.category %></span>
              <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--text-main); margin-top: 0.25rem;">
                <%= f.title %>
              </h3>
            </div>
            <div>
              <% if (f.status === 'pending') { %>
                <span class="badge badge-danger">Chờ tiếp nhận</span>
              <% } else if (f.status === 'in_progress') { %>
                <span class="badge badge-warning">Đang xử lý</span>
              <% } else { %>
                <span class="badge badge-success">Đã hoàn tất</span>
              <% } %>
            </div>
          </div>

          <p style="font-size: 0.95rem; color: #334155; line-height: 1.6; background: #F8FAFC; padding: 0.75rem; border-radius: var(--radius-sm); margin-bottom: 0.75rem;">
            <%= f.content %>
          </p>

          <% if (f.status === 'resolved') { %>
            <div style="background: #F0FDF4; border: 1px solid #86EFAC; border-left: 4px solid #16A34A; padding: 0.85rem 1rem; border-radius: var(--radius-sm); margin-bottom: 0.75rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; flex-wrap: wrap; gap: 0.4rem;">
                <strong style="color: #166534; font-size: 0.95rem; display: flex; align-items: center; gap: 0.35rem;">
                  <span>🛠️</span> Giải pháp & Kết quả xử lý của Ban Quản Lý:
                </strong>
                <% if (f.resolved_at) { %>
                  <span style="font-size: 0.75rem; background: #DCFCE7; color: #15803D; padding: 0.2rem 0.5rem; border-radius: 9999px; font-weight: 600;">
                    ✓ Hoàn tất: <%= new Date(f.resolved_at).toLocaleString('vi-VN') %>
                  </span>
                <% } %>
              </div>
              <div style="font-size: 0.9rem; color: #14532D; line-height: 1.6; white-space: pre-line;">
                <%= f.response_note || '✓ Kỹ thuật tòa nhà đã kiểm tra hiện trường, hoàn tất khắc phục và nghiệm thu đạt yêu cầu vận hành.' %>
              </div>
            </div>
          <% } else if (f.response_note) { %>
            <div style="background: #EFF6FF; border: 1px solid #BFDBFE; border-left: 4px solid #3B82F6; padding: 0.85rem 1rem; border-radius: var(--radius-sm); margin-bottom: 0.75rem;">
              <div style="margin-bottom: 0.35rem;">
                <strong style="color: #1E40AF; font-size: 0.95rem;">💬 Tiến độ / Biện pháp đang triển khai:</strong>
              </div>
              <div style="font-size: 0.9rem; color: #1E3A8A; line-height: 1.6; white-space: pre-line;">
                <%= f.response_note %>
              </div>
            </div>
          <% } %>

          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 0.75rem;">
            <div>
              👤 Cư dân: <strong><%= f.resident_name %></strong> (Căn <strong><%= f.apartment_number || 'N/A' %></strong> - <%= f.building_name || '' %>) • SĐT: <%= f.resident_phone %> • Gửi lúc: <%= new Date(f.created_at).toLocaleString('vi-VN') %>
            </div>
            <% if (user.role === 'admin') { %>
              <% if (f.status === 'resolved') { %>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                  <span style="color: var(--success); font-weight: 600; font-size: 0.85rem;">🔒 Đã hoàn tất (Đã khóa)</span>
                  <button class="btn btn-sm" style="background: #FEF3C7; color: #B45309; border: 1px solid #FCD34D; font-weight: 600;" onclick="openReopenModal('<%= f.id %>', `<%= (f.title || '').replace(/`/g, '\\`') %>`)">
                    Mở lại xử lý (Re-open) 🔄
                  </button>
                </div>
              <% } else { %>
                <button class="btn btn-sm btn-primary" onclick="openUpdateModal('<%= f.id %>', '<%= f.status %>', `<%= (f.response_note || '').replace(/`/g, '\\`') %>`)">
                  Cập nhật tiến độ / Phản hồi ✏️
                </button>
              <% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<!-- MODAL CẬP NHẬT PHẢN HỒI -->
<div id="updateFeedbackModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h3 style="color: var(--primary);">Xử Lý Ý Kiến Cư Dân</h3>
      <button class="close-modal" onclick="closeModal('updateFeedbackModal')">&times;</button>
    </div>
    <form id="feedbackForm" method="POST">
      <div class="form-group">
        <label>Trạng thái giải quyết</label>
        <select id="fbStatus" name="status" required>
          <option value="pending">Chờ tiếp nhận (Pending)</option>
          <option value="in_progress">Đang điều phối xử lý (In Progress)</option>
          <option value="resolved">Đã hoàn tất khắc phục (Resolved)</option>
        </select>
      </div>
      <div class="form-group">
        <label style="font-weight: 600; color: #0F172A;">🛠️ Giải pháp khắc phục / Nội dung xử lý sự cố (Hiển thị cho cư dân) <span style="color: red;">*</span></label>
        <textarea id="fbResponse" name="response_note" rows="4" placeholder="VD: Kỹ thuật tòa nhà đã kiểm tra hiện trường lúc 14h, thay mới rơ-le điều khiển và chạy nghiệm thu an toàn..." required></textarea>
        <small style="color: #64748B; font-size: 0.8rem; display: block; margin-top: 0.3rem;">
          💡 Ghi rõ giải pháp kỹ thuật đã áp dụng để cư dân nắm bắt được và yên tâm về chất lượng tòa nhà.
        </small>
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">Lưu Trạng Thái & Gửi Giải Pháp</button>
    </form>
  </div>
</div>

<!-- MODAL MỞ LẠI PHẢN HỒI (RE-OPEN) -->
<div id="reopenFeedbackModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h3 style="color: #B45309;">🔄 Mở Lại Xử Lý Phản Ánh</h3>
      <button class="close-modal" onclick="closeModal('reopenFeedbackModal')">&times;</button>
    </div>
    <form id="reopenForm" method="POST">
      <p style="font-size: 0.9rem; color: #475569; margin-bottom: 1rem;">
        Phản ánh: <strong id="reopenTitle"></strong><br>
        <span style="color: #64748B; font-size: 0.85rem;">Khi mở lại, phản ánh sẽ tự động chuyển về trạng thái <strong>Đang xử lý (In Progress)</strong> để đội kỹ thuật tiếp tục khắc phục.</span>
      </p>
      <div class="form-group">
        <label>Lý do mở lại xử lý (Bắt buộc) <span style="color: red;">*</span></label>
        <textarea name="reopen_reason" rows="3" required placeholder="VD: Sự cố tái phát sau 1 ngày, cư dân khiếu nại chưa dứt điểm, cần thay linh kiện mới..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%; background: #D97706; border-color: #D97706;">Xác Nhận Mở Lại & Chuyển Sang Đang Xử Lý</button>
    </form>
  </div>
</div>

<script>
  function openUpdateModal(id, status, responseNote) {
    document.getElementById('fbStatus').value = status;
    document.getElementById('fbResponse').value = responseNote;
    document.getElementById('feedbackForm').action = '/feedbacks/' + id + '/status';
    document.getElementById('updateFeedbackModal').classList.add('active');
  }
  function openReopenModal(id, title) {
    document.getElementById('reopenTitle').innerText = title;
    document.getElementById('reopenForm').action = '/feedbacks/' + id + '/reopen';
    document.getElementById('reopenFeedbackModal').classList.add('active');
  }
  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }
</script>

<%- include('../layouts/footer') %>
